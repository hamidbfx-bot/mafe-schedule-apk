    <main class="flex-1 p-5 space-y-5">
      <!-- Card Container -->
      <section class="bg-white rounded-2xl p-5 shadow-sm border border-[#ffd8e1]/60 space-y-5">
        
        <!-- 1. Student Name (Free Input + New Student Support) -->
        <div>
