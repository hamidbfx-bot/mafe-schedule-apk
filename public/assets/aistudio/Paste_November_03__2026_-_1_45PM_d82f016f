  </style>
</head>
<body class="flex justify-center min-h-screen p-0 sm:p-4">
  <div class="w-full max-w-md bg-[#fff8f7] text-[#1f1a1c] min-h-screen flex flex-col shadow-xl sm:rounded-3xl overflow-hidden pb-10">
    
    <!-- Top Header Bar -->
    <header class="flex items-center justify-between px-5 py-4 border-b border-[#ffd8e1]/40 bg-white/80 backdrop-blur-md sticky top-0 z-20">
      <div class="flex items-center gap-3">
        <a href="schedule.html" class="w-9 h-9 rounded-full flex items-center justify-center bg-[#fff0f2] text-[#be185d]">
          <span class="material-symbols-outlined text-xl">arrow_back</span>
        </a>
        <span class="font-bold text-lg text-[#be185d]">New Lesson Slot</span>
